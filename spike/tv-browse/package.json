{
  "name": "fluster-tv-browse-falsifier",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean --platform android --no-install",
    "art": "node scripts/generate-art.mjs",
    "serve-art": "node scripts/serve-art.mjs"
  },
  "dependencies": {
    "@shopify/flash-list": "2.3.3",
    "expo": "58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-image": "~58.0.18",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@react-native-tvos/config-tv": "0.1.7",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-image"]
      }
    },
    "install": {
      "exclude": ["react-native", "react-native-reanimated", "react-native-worklets", "@shopify/flash-list"]
    }
  }
}
