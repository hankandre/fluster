{
  "name": "fluster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dogfood-redaction": "bash scripts/dogfood-redaction-check.sh",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts && node scripts/build-visual-index.mjs",
    "test:visual:accept": "bash scripts/accept-visual-baselines.sh",
    "test:no-test-engine": "bash scripts/check-no-test-engine.sh",
    "fixture:up": "docker compose -f tests/integration/docker-compose.yml up -d --wait",
    "fixture:setup": "bash tests/integration/setup-servers.sh",
    "test:tripwire": "tsx tests/integration/tripwire.ts",
    "fixture:down": "docker compose -f tests/integration/docker-compose.yml down -v",
    "tauri": "tauri",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "samples:generate": "bash scripts/generate-samples.sh",
    "dogfood": "bash scripts/dogfood.sh",
    "typecheck:integration": "tsc -p tsconfig.integration.json",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "check": "pnpm lint:boundaries && pnpm test:dogfood-redaction && pnpm test && pnpm build && pnpm test:no-test-engine && pnpm typecheck:integration && pnpm typecheck:core && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@jellyfin/sdk": "1.0.2",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "~2.11.1",
    "axios": "^1.21.1",
    "blurhash": "2.0.5",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dependency-cruiser": "18.7.2",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "~7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "vite": "^6.4.5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=26"
  }
}
