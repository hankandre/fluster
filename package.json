{
  "name": "fluster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dogfood-redaction": "bash scripts/dogfood-redaction-check.sh",
    "test:e2e": "playwright test",
    "fixture:up": "docker compose -f tests/integration/docker-compose.yml up -d --wait",
    "fixture:setup": "bash tests/integration/setup-servers.sh",
    "fixture:down": "docker compose -f tests/integration/docker-compose.yml down -v",
    "tauri": "tauri",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "samples:generate": "bash scripts/generate-samples.sh",
    "dogfood": "bash scripts/dogfood.sh",
    "check": "pnpm lint:boundaries && pnpm test:dogfood-redaction && pnpm test && pnpm build && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@jellyfin/sdk": "1.0.2",
    "@tanstack/react-query": "^5.59.0",
    "@tauri-apps/api": "^2.0.0",
    "axios": "^1.21.0",
    "blurhash": "2.0.5",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "dependency-cruiser": "18.7.2",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.0",
    "vite": "^6.4.5",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=26"
  }
}
