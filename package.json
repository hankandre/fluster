{
  "name": "octave",
  "private": true,
  "version": "0.1.0",
  "description": "A Jellyfin and Jellyscale client for the TV that plays the original file whenever the device can.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workflow": "node --test .claude/workflows/task.test.mjs",
    "test:tripwire": "tsx tests/integration/tripwire.ts",
    "fixture:up": "docker compose -f tests/integration/docker-compose.yml up -d --wait",
    "fixture:setup": "bash tests/integration/setup-servers.sh",
    "fixture:down": "docker compose -f tests/integration/docker-compose.yml down -v",
    "samples:generate": "bash scripts/generate-samples.sh",
    "lint": "node --import ./scripts/typescript-6-resolve.mjs node_modules/eslint/bin/eslint.js --max-warnings 0 src",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "lint:ghost-terms": "node scripts/check-ghost-terms.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json",
    "check": "pnpm lint:boundaries && pnpm lint && pnpm lint:ghost-terms && pnpm test && pnpm typecheck && pnpm test:workflow"
  },
  "dependencies": {
    "@jellyfin/sdk": "1.0.2",
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "8.73.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "~7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=26"
  }
}
