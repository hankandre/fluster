{
  "name": "fluster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dogfood-redaction": "bash scripts/dogfood-redaction-check.sh",
    "test:e2e": "playwright test",
    "fixture:up": "docker compose -f tests/integration/docker-compose.yml up -d --wait",
    "fixture:setup": "bash tests/integration/setup-servers.sh",
    "test:tripwire": "tsx tests/integration/tripwire.ts",
    "fixture:down": "docker compose -f tests/integration/docker-compose.yml down -v",
    "tauri": "tauri",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "samples:generate": "bash scripts/generate-samples.sh",
    "dogfood": "bash scripts/dogfood.sh",
    "typecheck:integration": "tsc -p tsconfig.integration.json",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "check": "pnpm lint:boundaries && pnpm test:dogfood-redaction && pnpm test && pnpm build && pnpm typecheck:integration && pnpm typecheck:core && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@jellyfin/sdk": "1.0.2",
    "@tanstack/react-query": "^5.106.0",
    "@tauri-apps/api": "~2.11.1",
    "axios": "^1.21.0",
    "blurhash": "2.0.5",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "dependency-cruiser": "18.7.2",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.3.4",
    "tsx": "4.23.15",
    "typescript": "~5.7.0",
    "vite": "^6.4.5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=26"
  }
}
