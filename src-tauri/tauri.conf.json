{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluster",
  "version": "0.1.0",
  "identifier": "com.hankandre.fluster",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Fluster",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data: https: http://localhost:* http://127.0.0.1:*; media-src 'self' https: http://localhost:* http://127.0.0.1:* blob:; style-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [],
    "resources": ["resources/*"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
