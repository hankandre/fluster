{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/lib/jellyfin/**/*.ts",
    "src/lib/player/coordinator.ts",
    "src/lib/player/playstate-reporter.ts",
    "src/lib/player/session-state.ts",
    "src/lib/redact.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"]
}
